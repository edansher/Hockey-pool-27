# Hockey Pool 2026-27 — independent copy. PLACEHOLDERS ONLY.
# Copy to .env and fill in values for THIS copy's own services.
# Never paste credentials from the original Replit app here.

# --- Database (this copy's own Postgres; never the original's) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hockey_pool_copy

# --- API server ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# Serve the built website from the API process (single-server deployment)
FRONTEND_DIST=artifacts/hockey-pool/dist/public

# --- Clerk authentication (create a NEW Clerk application for the copy) ---
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Optional. Leave empty to use Clerk's own frontend API directly.
# The original app routed Clerk through /api/__clerk in production (Replit-managed).
VITE_CLERK_PROXY_URL=

# --- Pool configuration ---
# Administrator (verified Clerk email). Defaults to the original administrator.
POOL_ADMIN_EMAIL=admin@example.com
# Participant email directory: JSON object of owner id -> email. Owner ids:
# cohen, weezbark, rob, korm, edan, joe, drb-and-son, nana, jimmy
POOL_PARTICIPANT_EMAILS={"cohen":"cohen@example.com","edan":"edan@example.com"}

# --- Safety switches (keep false until the copy is verified) ---
ENABLE_BACKGROUND_JOBS=false
ENABLE_DAILY_REPORT=false

# --- OpenAI (only needed when ENABLE_DAILY_REPORT=true; paid service) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
DAILY_REPORT_MODEL=gpt-5.6-terra

# --- Website build ---
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:8080
